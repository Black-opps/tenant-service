# API Settings
API_VERSION=v1
API_PORT=8004
DEBUG=false
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://mpesa_user:secure_password@postgres:5432/tenant_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TENANT_TOPIC=tenant-events
KAFKA_AUDIT_TOPIC=audit-events

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
BCRYPT_ROUNDS=12

# Email (for invitations)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
FROM_EMAIL=noreply@mpesa-saas.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8003

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO